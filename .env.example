# 环境变量模板
# 创建时间：2026-03-07 23:00

# ==================== 数据库配置 ====================
# MySQL数据库连接字符串
DATABASE_URL="mysql://root:password@localhost:3306/wuhan_life"

# ==================== NextAuth配置 ====================
# NextAuth密钥（生产环境请使用强密码）
NEXTAUTH_SECRET="your-secret-key-here-change-in-production"

# 应用URL
NEXTAUTH_URL="http://localhost:3000"

# ==================== 地图配置 ====================
# 高德地图API Key（申请地址：https://lbs.amap.com/）
NEXT_PUBLIC_AMAP_KEY="your-amap-api-key-here"

# ==================== API配置 ====================
# API基础URL
NEXT_PUBLIC_API_URL="http://localhost:3000/api"

# ==================== 其他配置 ====================
# 运行环境（development/production）
NODE_ENV="development"

# 是否启用缓存
NEXT_PUBLIC_ENABLE_CACHE="true"

# ==================== 飞书配置（可选） ====================
# 飞书应用ID
# FEISHU_APP_ID="your-feishu-app-id"

# 飞书应用密钥
# FEISHU_APP_SECRET="your-feishu-app-secret"

# ==================== 性能监控（可选） ====================
# 是否启用性能监控
# ENABLE_PERFORMANCE_MONITORING="true"

# 性能监控上报地址
# PERFORMANCE_MONITOR_URL="https://your-monitoring-service.com/api"
