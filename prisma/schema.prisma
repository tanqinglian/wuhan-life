// 武汉生活 - 数据库模型（SQLite兼容）

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 区域表
model District {
  id        Int      @id @default(autoincrement())
  name      String   @unique // 江汉区、武昌区等
  order     Int      @default(0)
  markets   Market[]
  createdAt DateTime @default(now())
}

// 夜市表
model Market {
  id          Int       @id @default(autoincrement())
  name        String
  districtId  Int
  district    District  @relation(fields: [districtId], references: [id])
  address     String
  description String?
  openHours   String?   // 营业时间，如 "18:00-02:00"
  bestTime    String?   // 最佳时间
  traffic     String?   // 交通指南
  tips        String?   // 实用贴士
  latitude    Float?
  longitude   Float?
  images      String    // JSON字符串存储数组
  rating      Float     @default(0)
  viewCount   Int       @default(0)
  isActive    Boolean   @default(true)
  foods       Food[]
  reviews     Review[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([districtId])
  @@index([rating])
}

// 小吃表
model Food {
  id          Int       @id @default(autoincrement())
  name        String
  marketId    Int
  market      Market    @relation(fields: [marketId], references: [id], onDelete: Cascade)
  shopName    String?   // 店铺/摊位名称
  price       String?   // 价格范围，如 "10-20元"
  description String?
  tags        String    // JSON字符串存储数组
  images      String    // JSON字符串存储数组
  rating      Float     @default(0)
  recommend   Int       @default(0) // 推荐指数
  reviews     Review[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([marketId])
  @@index([rating])
}

// 跑山路线表
model Route {
  id            Int        @id @default(autoincrement())
  name          String
  direction     String     // 东南西北
  distance      Int        // 里程（公里）
  duration      String     // 预计时长，如 "3-4小时"
  difficulty    Int        @default(1) // 1-5 难度等级
  description   String
  roadCondition String?   // 路况说明
  bestSeason    String?   // 最佳季节
  tips          String?   // 出行建议
  startpoint    String    // 起点
  endpoint      String    // 终点
  coordinates   String?   // 轨迹坐标 JSON
  images        String    // JSON字符串存储数组
  rating        Float     @default(0)
  viewCount     Int       @default(0)
  isActive      Boolean   @default(true)
  waypoints     Waypoint[]
  reviews       Review[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([direction])
  @@index([difficulty])
  @@index([rating])
}

// 途经点表
model Waypoint {
  id          Int      @id @default(autoincrement())
  routeId     Int
  route       Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  name        String
  description String?
  latitude    Float?
  longitude   Float?
  order       Int      @default(0)
  isHighlight Boolean  @default(false) // 是否为推荐打卡点
  createdAt   DateTime @default(now())

  @@index([routeId])
}

// 评价表（通用）
model Review {
  id          Int      @id @default(autoincrement())
  userId      String   // 暂用微信 openid
  targetType  String   // "market" | "food" | "route"
  targetId    Int
  market      Market?  @relation(fields: [targetId], references: [id], onDelete: Cascade)
  food        Food?    @relation(fields: [targetId], references: [id], onDelete: Cascade)
  route       Route?   @relation(fields: [targetId], references: [id], onDelete: Cascade)
  rating      Int      // 1-5
  content     String?
  images      String   // JSON字符串存储数组
  likes       Int      @default(0)
  isAnonymous Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([targetType, targetId])
  @@index([userId])
}

// 用户表
model User {
  id           String     @id // 微信 openid
  nickname     String?
  avatar       String?
  phone        String?
  favorites    Favorite[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

// 收藏表
model Favorite {
  id         Int      @id @default(autoincrement())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetType String   // "market" | "food" | "route"
  targetId   Int
  createdAt  DateTime @default(now())

  @@unique([userId, targetType, targetId])
  @@index([userId])
}
