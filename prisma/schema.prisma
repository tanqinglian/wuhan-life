generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model districts {
  id        Int       @id @default(autoincrement())
  name      String    @unique(map: "name") @db.VarChar(50)
  order     Int?      @default(0)
  createdAt DateTime? @default(now()) @db.DateTime(0)
  markets   markets[]
}

model favorites {
  id         Int       @id @default(autoincrement())
  userId     String    @db.VarChar(100)
  targetType String    @db.VarChar(20)
  targetId   Int
  createdAt  DateTime? @default(now()) @db.DateTime(0)
  users      users     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "favorites_ibfk_1")

  @@unique([userId, targetType, targetId], map: "unique_favorite")
  @@index([userId], map: "idx_user")
}

model foods {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(100)
  marketId    Int
  shopName    String?   @db.VarChar(100)
  price       String?   @db.VarChar(50)
  description String?   @db.Text
  tags        String?   @db.Text
  images      String?   @db.Text
  rating      Float?    @default(0) @db.Float
  recommend   Int?      @default(0)
  createdAt   DateTime? @default(now()) @db.DateTime(0)
  updatedAt   DateTime? @default(now()) @db.DateTime(0)
  markets     markets   @relation(fields: [marketId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "foods_ibfk_1")

  @@index([marketId], map: "idx_market")
  @@index([rating], map: "idx_rating")
}

model markets {
  id          Int        @id @default(autoincrement())
  name        String     @db.VarChar(100)
  districtId  Int?
  address     String?    @db.VarChar(200)
  description String?    @db.Text
  openHours   String?    @db.VarChar(50)
  bestTime    String?    @db.VarChar(50)
  traffic     String?    @db.VarChar(200)
  tips        String?    @db.Text
  latitude    Float?     @db.Float
  longitude   Float?     @db.Float
  images      String?    @db.Text
  rating      Float?     @default(0) @db.Float
  viewCount   Int?       @default(0)
  isActive    Boolean?   @default(true)
  createdAt   DateTime?  @default(now()) @db.DateTime(0)
  updatedAt   DateTime?  @default(now()) @db.DateTime(0)
  foods       foods[]
  districts   districts? @relation(fields: [districtId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "markets_ibfk_1")

  @@index([districtId], map: "idx_district")
  @@index([rating], map: "idx_rating")
  @@index([isActive], map: "idx_active")
  @@index([viewCount], map: "idx_viewcount")
  @@index([createdAt], map: "idx_created")
  @@index([rating, isActive], map: "idx_rating_active")
}

model reviews {
  id          Int       @id @default(autoincrement())
  userId      String    @db.VarChar(100)
  targetType  String    @db.VarChar(20)
  targetId    Int
  rating      Int
  content     String?   @db.Text
  images      String?   @db.Text
  likes       Int?      @default(0)
  isAnonymous Boolean?  @default(false)
  createdAt   DateTime? @default(now()) @db.DateTime(0)
  updatedAt   DateTime? @default(now()) @db.DateTime(0)

  @@index([targetType, targetId], map: "idx_target")
  @@index([userId], map: "idx_user")
}

model routes {
  id            Int         @id @default(autoincrement())
  name          String      @db.VarChar(100)
  direction     String?     @db.VarChar(20)
  distance      Int?
  duration      String?     @db.VarChar(50)
  difficulty    Int?        @default(1)
  description   String?     @db.Text
  roadCondition String?     @db.Text
  bestSeason    String?     @db.VarChar(100)
  tips          String?     @db.Text
  startpoint    String?     @db.VarChar(200)
  endpoint      String?     @db.VarChar(200)
  coordinates   String?     @db.Text
  images        String?     @db.Text
  rating        Float?      @default(0) @db.Float
  viewCount     Int?        @default(0)
  isActive      Boolean?    @default(true)
  createdAt     DateTime?   @default(now()) @db.DateTime(0)
  updatedAt     DateTime?   @default(now()) @db.DateTime(0)
  waypoints     waypoints[]

  @@index([difficulty], map: "idx_difficulty")
  @@index([rating], map: "idx_rating")
  @@index([isActive], map: "idx_active")
  @@index([viewCount], map: "idx_viewcount")
  @@index([createdAt], map: "idx_created")
  @@index([difficulty, rating], map: "idx_difficulty_rating")
  @@index([rating, isActive], map: "idx_rating_active")
}

model users {
  id        String      @id @db.VarChar(100)
  nickname  String?     @db.VarChar(100)
  avatar    String?     @db.VarChar(200)
  phone     String?     @db.VarChar(20)
  createdAt DateTime?   @default(now()) @db.DateTime(0)
  updatedAt DateTime?   @default(now()) @db.DateTime(0)
  favorites favorites[]
}

model waypoints {
  id          Int       @id @default(autoincrement())
  routeId     Int
  name        String    @db.VarChar(100)
  description String?   @db.Text
  latitude    Float?    @db.Float
  longitude   Float?    @db.Float
  order       Int?      @default(0)
  isHighlight Boolean?  @default(false)
  createdAt   DateTime? @default(now()) @db.DateTime(0)
  routes      routes    @relation(fields: [routeId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "waypoints_ibfk_1")

  @@index([routeId], map: "idx_route")
}
